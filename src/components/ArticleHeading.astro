---
import CookSectionIcon from "../icons/cook-section.svg";
import IngredientsSectionIcon from "../icons/ingredients-section.svg";

const headingHtml = await Astro.slots.render("default");
const headingText = headingHtml.replace(/<[^>]+>/g, "").trim().toLowerCase();
const Icon = headingText.includes("ingred") ? IngredientsSectionIcon : CookSectionIcon;
---

<h2>
  <Icon class="section-icon" aria-hidden="true" />
  <span set:html={headingHtml} />
</h2>

<style>
  @layer components {
    h2 {
      display: flex;
      gap: var(--space-xxs);
      align-items: center;
    }

    .section-icon {
      width: 1em;
      height: 1em;
      flex: none;
      margin-inline: calc(0.1em + 3px);
      color: var(--gray-500);
    }
  }
</style>
